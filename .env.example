# =============================================================================
# Vidyakshara — Production Environment Configuration (.env.example)
# Copy this file to `.env` for local development or configure these variables
# in your hosting dashboard (e.g., Render -> Environment Variables).
# NEVER commit real API keys or database credentials to Git.
# =============================================================================

# Server runtime environment ("development" or "production")
NODE_ENV="production"

# HTTP port & bind host (Render automatically injects PORT at runtime)
PORT="3000"
HOST="0.0.0.0"

# GEMINI_API_KEY: Server-only API key for Google Gemini AI Tutor & Career Commentary.
# Obtain from Google AI Studio (https://aistudio.google.com/apikey).
# Optional for the Career Intelligence Test (deterministic scoring & PDF download work without it).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Optional PostgreSQL connection string for persistent production storage
# (e.g. Render PostgreSQL Internal Database URL, Neon, or Supabase).
# When set, Vidyakshara automatically creates the required tables on server startup.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Set to "false" only when connecting to a local PostgreSQL server without SSL.
DATABASE_SSL="true"

# DATA_DIR: Directory for atomic JSON file persistence when DATABASE_URL is not set
# (or when using a Render Persistent Disk mounted at /var/data).
DATA_DIR=".data"

# APP_URL: Public base URL of the deployed application
APP_URL="https://your-vidyakshara-service.onrender.com"
